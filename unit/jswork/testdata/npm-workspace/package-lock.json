{
  "name": "acme-npm-monorepo",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "acme-npm-monorepo",
      "version": "0.0.0",
      "workspaces": [
        "packages/*",
        "apps/*",
        "!packages/deprecated"
      ]
    },
    "apps/web": {
      "name": "@acme/web",
      "version": "0.1.0",
      "dependencies": {
        "@acme/store": "*"
      },
      "devDependencies": {
        "@acme/testkit": "*"
      }
    },
    "node_modules/@acme/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@acme/store": {
      "resolved": "packages/data-store",
      "link": true
    },
    "node_modules/@acme/testkit": {
      "resolved": "packages/testkit",
      "link": true
    },
    "node_modules/@acme/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/core": {
      "name": "@acme/core",
      "version": "0.1.0"
    },
    "packages/data-store": {
      "name": "@acme/store",
      "version": "0.1.0",
      "dependencies": {
        "@acme/core": "^0.1.0"
      }
    },
    "packages/testkit": {
      "name": "@acme/testkit",
      "version": "0.1.0"
    }
  }
}
